{
  "name": "relaypatch",
  "displayName": "RelayPatch",
  "description": "Review and apply AI-generated code patches from your phone",
  "version": "0.1.0",
  "publisher": "relaypatch",
  "engines": { "vscode": "^1.93.0" },
  "categories": ["Other"],
  "activationEvents": ["*"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "relaypatch.openDiff", "title": "RelayPatch: Open Incoming Diff" },
      { "command": "relaypatch.startBridgeListener", "title": "RelayPatch: Start Bridge Listener" },
      { "command": "relaypatch.stopBridgeListener", "title": "RelayPatch: Stop Bridge Listener" }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runTest.js",
    "package": "npx vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.93.0",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^9.9.1",
    "typescript": "^5.5.4",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.1.0"
  }
}
